# Database
POSTGRES_PASSWORD="changeme-strong-password"
POSTGRES_PORT="5432"

# Auth / Security — REQUIRED. Generate: openssl rand -hex 32
JWT_SECRET="change-me-32-chars-min"
CSRF_SECRET="change-me-32-chars-min"

# Ports
API_PORT="3000"
WEB_PORT="3001"

# File storage (only used when --profile files)
MINIO_ROOT_USER="lifeos"
MINIO_ROOT_PASSWORD="changeme"
MINIO_PORT="9000"
MINIO_CONSOLE_PORT="9001"

# Feature flags (JSON object)
FEATURES='{"workspaceSwitcher":true,"cmdK":true,"webhooks":false,"localFirst":false}'

# Observability (optional)
SENTRY_DSN=""

# Public API
RATE_LIMIT_API_PER_MIN="300"
RATE_LIMIT_AUTH_PER_MIN="60"

# Web app URL (CLI device-code flow). Required in production.
# Dev fallback: localhost:5176. Example: https://app.lifeos.com
PUBLIC_WEB_URL=""
