# Local dev — Postgres connection string
# Replace user/password/host as needed. For pgAdmin local install on Windows:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lifeos_dev?schema=public"

# Auth secrets — generate: openssl rand -hex 32
JWT_SECRET="dev-only-secret-min-32-chars-replace-in-prod"
CSRF_SECRET="dev-only-csrf-secret-min-32-chars-replace"
COOKIE_NAME="lifeos_session"

# Public base URL (used for magic links + email + Stripe redirects)
PUBLIC_BASE_URL="http://localhost:5176"

# Optional — leave blank to disable
RESEND_API_KEY=""
EMAIL_FROM="LifeOS <noreply@localhost>"
SENTRY_DSN=""
REDIS_URL=""
INTERNAL_WORKER_TOKEN="dev-worker-token"

# Stripe (optional — billing endpoints return 503 without these)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PERSONAL=""
STRIPE_PRICE_STUDIO=""

# Google OAuth (optional)
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
