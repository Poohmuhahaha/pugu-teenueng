{
  "name": "@lifeos/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "prisma generate && deno run -A ../../scripts/patch-prisma.js && vite build",
    "start": "node build",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@lifeos/core": "workspace:*",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lru-cache": "^11.0.0",
    "zod": "^3.23.8"
  },
  "peerDependenciesMeta": {
    "stripe": { "optional": true },
    "@sentry/node": { "optional": true },
    "resend": { "optional": true },
    "ioredis": { "optional": true }
  },
  "peerDependencies": {
    "stripe": "^17.0.0",
    "@sentry/node": "^8.0.0",
    "resend": "^4.0.0",
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.15.0",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "prisma": "^5.22.0",
    "svelte": "^4.2.19",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
