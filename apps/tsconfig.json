{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "paths": {
      "@huuk/*": ["../../../components/huuk/*"],
      "@/components/*": ["../../../components/huuk/*"],
      "@/composables/*": ["../../../components/huuk/composables/*"],
      "@/core/*": ["../../../components/huuk/core/*"],
      "@/mock/*": ["../../../components/huuk/mock/*"],
      "@/*": ["./src/*"],
      "hyperformula": ["./node_modules/hyperformula"]
    },
    "types": ["vite/client"],
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
