{
  "slug": "personal-crm",
  "name": "Personal CRM",
  "description": "Track relationships, last-contact dates, and follow-up cadence.",
  "schema": {
    "fields": [
      { "name": "name",          "type": "text",     "required": true },
      { "name": "email",         "type": "text" },
      { "name": "company",       "type": "text" },
      { "name": "relationship",  "type": "select",   "options": ["family","friend","colleague","client","mentor","other"] },
      { "name": "lastContacted", "type": "date" },
      { "name": "cadenceDays",   "type": "number" },
      { "name": "notes",         "type": "richtext" },
      { "name": "tags",          "type": "text" }
    ]
  }
}
