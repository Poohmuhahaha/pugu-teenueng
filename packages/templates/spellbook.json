      { "name": "school",      "type": "select",   "options": ["abjuration", "conjuration", "divination", "enchantment", "evocation", "illusion", "necromancy", "transmutation", "lore"] },
      { "name": "manaCost",    "type": "number" },
      { "name": "source",      "type": "text" },
      { "name": "notes",       "type": "richtext" }
    ]
  }
}
